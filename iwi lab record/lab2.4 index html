<!DOCTYPE html>
<html>
<head>
    <title>Animated Button</title>
    <style>
        button {
            padding: 15px 30px;
            font-size: 16px;
            background-color: blue;
            color: white;
            border: none;
            cursor: pointer;
            transition: background-color 0.5s, transform 0.3s;
        }

        button:hover {
            background-color: red;
            transform: scale(1.1);
        }
    </style>
</head>
<body>

<button>Hover Me</button>

</body>
</html>